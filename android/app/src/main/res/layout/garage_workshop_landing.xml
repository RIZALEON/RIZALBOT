<?xml version="1.0" encoding="utf-8"?>
<!-- Garage workshop landing — twin of Swift GarageWorkshopLandingView (0.3.1): room bg + left sidebar.
     Housed bots come from the Garage roster (BotRoster · seat/BOT-LABELS.json v3), not a fixed list.
     + Create new Bot requires a name (the name it speaks with). Work strip: Speak / Я speaks · Clear.
     Sits under sticky ЯBAR (hosted inside activity_main middle). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/garage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/garage_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/garage_workshop"
        android:scaleType="centerCrop"
        android:contentDescription="Garage workshop room" />

    <!-- Shelf (middle bay): faces of housed bots that have a shelf spot, filled from the roster -->
    <LinearLayout
        android:id="@+id/garage_shelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="84dp"
        android:orientation="horizontal"
        android:padding="8dp" />

    <!-- Left clay sidebar -->
    <ScrollView
        android:id="@+id/garage_sidebar_scroll"
        android:layout_width="176dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#CC1A0F18"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/garage_sidebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Я / GARAGE"
                android:textColor="#F5F0E8"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/garage_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search bots"
                android:textColorHint="#8A7C70"
                android:textColor="#F5F0E8"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:background="#73000000"
                android:padding="8dp" />

            <TextView
                android:id="@+id/garage_nav_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Create new Bot"
                android:textColor="#E8E0D4"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/garage_create_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <EditText
                    android:id="@+id/garage_create_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name (as it will speak)"
                    android:textColorHint="#8A7C70"
                    android:textColor="#F5F0E8"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:maxLength="60"
                    android:background="#73000000"
                    android:padding="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">
                    <TextView
                        android:id="@+id/garage_create_go"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create"
                        android:textColor="#F5F0E8"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="#66C97A27"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="no numbers · no duplicates"
                        android:textColor="#8A7C70"
                        android:textSize="9sp"
                        android:paddingStart="6dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/garage_create_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C8BEB2"
                    android:textSize="10sp"
                    android:paddingTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/garage_nav_bots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Housed bots · kids of Я"
                android:textColor="#A89888"
                android:textSize="11sp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <!-- Garage roster rows (designated names + faces) — filled in code -->
            <LinearLayout
                android:id="@+id/garage_bot_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/garage_nav_marketplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marketplace"
                android:textColor="#E8E0D4"
                android:textSize="14sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/garage_nav_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stats"
                android:textColor="#E8E0D4"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/garage_nav_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data"
                android:textColor="#E8E0D4"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/garage_nav_training"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Training"
                android:textColor="#E8E0D4"
                android:textSize="14sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/garage_lane_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8A7C70"
                android:textSize="10sp"
                android:paddingTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Work strip when a bot is selected: Working with <Name> · Speak / Я speaks · Clear -->
    <LinearLayout
        android:id="@+id/garage_work_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="184dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:background="#B8000000"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/garage_work_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F0E8"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/garage_work_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A8A098"
            android:textSize="10sp"
            android:paddingBottom="6dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/garage_work_speak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speak"
                android:textColor="#F5F0E8"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="#66C97A27"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/garage_work_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Clear"
                android:textColor="#C8BEB2"
                android:textSize="11sp"
                android:background="#22FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
